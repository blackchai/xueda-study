VITE_BUSINESS_DATA_MODE=api
# Render sets RENDER_EXTERNAL_URL automatically. Other hosts must set their HTTPS origin.
STUDYMATE_PUBLIC_ORIGIN=
# Supply both URLs as cloud Secrets; use a direct endpoint for migrations.
STUDYMATE_DATABASE_URL=
STUDYMATE_MIGRATION_DATABASE_URL=

POSTGRES_DB=studymate
POSTGRES_USER=studymate
POSTGRES_PASSWORD=replace-with-a-long-random-password

STUDYMATE_APP_ENV=production
STUDYMATE_AUTO_CREATE_SCHEMA=false
STUDYMATE_CANONICAL_HOST=
STUDYMATE_AUTH_SIGNING_SECRET=replace-with-at-least-32-random-bytes
STUDYMATE_AUTH_COOKIE_NAME=studymate_session
STUDYMATE_AUTH_COOKIE_SECURE=true
STUDYMATE_AUTH_COOKIE_SAMESITE=lax
STUDYMATE_AUTH_SESSION_DAYS=30
STUDYMATE_LOGIN_MAX_FAILURES=5
STUDYMATE_LOGIN_WINDOW_MINUTES=15
STUDYMATE_LOGIN_LOCK_MINUTES=15
STUDYMATE_CORS_ORIGINS=
