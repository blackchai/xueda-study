# 本地开发可使用 SQLite；公网部署请替换为 PostgreSQL asyncpg URL。
STUDYMATE_APP_ENV=development
STUDYMATE_DATABASE_URL=sqlite+aiosqlite:///./studymate_dev.db
STUDYMATE_MIGRATION_DATABASE_URL=
STUDYMATE_PUBLIC_ORIGIN=
STUDYMATE_AUTO_CREATE_SCHEMA=false
STUDYMATE_CANONICAL_HOST=

# 生产环境必须替换为至少 32 字节的随机值。
STUDYMATE_AUTH_SIGNING_SECRET=replace-with-a-long-random-secret
STUDYMATE_AUTH_COOKIE_NAME=studymate_session
STUDYMATE_AUTH_COOKIE_SECURE=false
STUDYMATE_AUTH_COOKIE_SAMESITE=lax
STUDYMATE_AUTH_SESSION_DAYS=30
STUDYMATE_LOGIN_MAX_FAILURES=5
STUDYMATE_LOGIN_WINDOW_MINUTES=15
STUDYMATE_LOGIN_LOCK_MINUTES=15

# 逗号分隔；Nginx 同源部署时可留空。
STUDYMATE_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# 邀请按发送账号持久化限流；取消/拒绝也计入发送次数，防止刷屏。
STUDYMATE_BUDDY_INVITES_PER_HOUR=10
STUDYMATE_BUDDY_INVITES_PER_DAY=30
STUDYMATE_BUDDY_PENDING_LIMIT=20
STUDYMATE_BUDDY_PAIR_COOLDOWN_SECONDS=300
